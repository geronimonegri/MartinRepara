# Copiá este archivo a ".env" (en esta misma carpeta, junto a manage.py) y
# completá los valores para tu entorno. En desarrollo local podés dejarlo
# sin crear: los defaults de config/settings.py ya funcionan.

# Clave secreta de Django. OBLIGATORIO generar una propia y mantenerla en
# secreto en producción. Generarla con:
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# En producción SIEMPRE debe ser False.
DEBUG=True

# Dominios/IPs permitidos, separados por coma. OBLIGATORIO completar en
# producción (con DEBUG=False, Django rechaza cualquier host que no esté acá).
# Ejemplo: ALLOWED_HOSTS=martinrepara.com,www.martinrepara.com
ALLOWED_HOSTS=
